# Production environment template for docker-compose.prod.yml (copy to .env.production — git-ignored — and fill every
# value from AWS Secrets Manager). On ECS, inject these as task-definition secrets instead. See docs/ops/deploy-aws.md §9.
APP_VERSION=
REGISTRY=<account>.dkr.ecr.ap-south-1.amazonaws.com/northstar
APP_DOMAIN=people.example.in
APP_BASE_URL=https://people.example.in
CORS_ORIGIN=https://people.example.in
TRUST_PROXY=1
NEXT_PUBLIC_PLATFORM_API_URL=https://api.people.example.in
NEXT_PUBLIC_APP_DOMAIN=people.example.in
NEXT_PUBLIC_OIDC_ISSUER=

DATABASE_URL=postgresql://hrm_app:<secret>@<rds-endpoint>:5432/hrm?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_URL_RUNTIME=postgresql://hrm_runtime:<secret>@<rds-endpoint>:5432/hrm?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
# First install only (migrate job creates/updates hrm_runtime), then remove:
DATABASE_ADMIN_URL=
RUNTIME_DB_PASSWORD=

REDIS_URL=rediss://:<auth-token>@<elasticache-endpoint>:6379
REDIS_PASSWORD=<only for the bundled redis service>

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
AUTH_SIGNING_KEY=
AUTH_ISSUER=https://api.people.example.in

DATA_ENCRYPTION_KEYS=k2026a:<openssl rand -base64 32>
DATA_ENCRYPTION_ACTIVE_KEY=k2026a
DATA_INDEX_KEY=<openssl rand -base64 32>
INTEGRATIONS_MASTER_KEY=<openssl rand -hex 32>
PAYOUTS_WEBHOOK_SECRET=<24+ chars, shared with the payout provider>

FILES_S3_BUCKET=northstar-people-files-prod
FILES_S3_REGION=ap-south-1
FILES_S3_PREFIX=prod
FILES_S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:<account>:key/<id>

SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ClanChief <no-reply@people.example.in>

SENTRY_DSN=
LOG_LEVEL=info
