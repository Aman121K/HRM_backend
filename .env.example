NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:4100
NEXT_PUBLIC_DEMO_EMPLOYEE_ID=BT002
NEXT_PUBLIC_DEMO_MANAGER_ID=BT001
NEXT_PUBLIC_DEMO_HR_ID=BT000
NEXT_PUBLIC_ALLOW_DEMO_IDENTITY=true
BACKEND_PORT=4000
BACKEND_V2_PORT=4100
CORS_ORIGINS=http://localhost:3000
HRM_DB_PATH=.data/hrm.sqlite
DATABASE_URL=postgresql://hrm_app:hrm_local_dev@localhost:5432/hrm_dev
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Configure these for real delivery. Without SMTP_HOST, mail is logged locally as JSON.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hr@your-company.com
# Phase-0 modular backend. Demo identity must be disabled in production.
ALLOW_DEMO_IDENTITY=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
REDIS_URL=
# Web sign-in (Authorization Code + PKCE public client). For local testing run `npm run dev:idp`.
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email

# Least-privilege role for tenant queries (must NOT own tables or have BYPASSRLS). See db/runtime-role.sql
DATABASE_URL_RUNTIME=

# --- Hardening (see README "Security") ---
# API listen address: 127.0.0.1 locally; 0.0.0.0 inside containers.
BIND_HOST=127.0.0.1
# Behind a load balancer: true (= exactly one hop), a hop count, or a comma-separated list of proxy CIDRs.
TRUST_PROXY=
# Per-IP ceiling for signed-in traffic (requests/min) and failed-authentication budget per IP.
RATE_LIMIT_IP_CEILING=30000
RATE_LIMIT_AUTH_FAILURES=120

# --- File storage ---
# local = .data/uploads (development only; production refuses to start). s3 = AWS S3 (Mumbai) or S3-compatible.
FILES_STORAGE=local
# FILES_S3_BUCKET=northstar-people-files
# FILES_S3_REGION=ap-south-1
# Environment folder inside the bucket so staging and production never mix: prod / staging
# FILES_S3_PREFIX=prod
# Optional: customer-managed KMS key (recommended). Without it SSE-S3 (AES-256) is used.
# FILES_S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:<account>:key/<id>
# S3-compatible stores only (MinIO, R2, Spaces). On AWS leave these empty and use an IAM role.
# FILES_S3_ENDPOINT=
# FILES_S3_FORCE_PATH_STYLE=false
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_SSE=AES256

# --- Billing: your company's details on GST invoices (Super admin → Billing settings override these) ---
# OPERATOR_LEGAL_NAME=
# OPERATOR_GSTIN=
# OPERATOR_PAN=
# OPERATOR_ADDRESS=
# Two-digit GST state code of your registration (e.g. 29 = Karnataka) — decides CGST+SGST vs IGST.
# OPERATOR_STATE=
# OPERATOR_EMAIL=
# OPERATOR_BANK_DETAILS=

# --- Legal pages (/legal/*) — fill before launch, then have a lawyer review the texts ---
# LEGAL_PRODUCT_NAME=ClanChief
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_ADDRESS=
# LEGAL_CIN=
# LEGAL_GSTIN=
# LEGAL_CONTACT_EMAIL=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_SECURITY_EMAIL=
# LEGAL_GRIEVANCE_OFFICER=
# LEGAL_JURISDICTION_CITY=
# LEGAL_EFFECTIVE_DATE=
# LEGAL_HOSTING_PROVIDER=Amazon Web Services
# LEGAL_HOSTING_REGION=Mumbai (ap-south-1)
# LEGAL_EMAIL_REGION=

# --- First-party sign-in (required in production) ---
# AUTH_SIGNING_KEY=   # Ed25519 or P-256 private key (PEM/JWK) from your secrets manager
# AUTH_ISSUER=https://api.<your-domain>

# --- Receipt OCR (expense claims) ---
# auto (default) = Claude when ANTHROPIC_API_KEY is set, else offline tesseract (images) / pdf-text (PDFs). Or: anthropic | tesseract
# RECEIPT_OCR_PROVIDER=auto
# ANTHROPIC_API_KEY=
# ANTHROPIC_OCR_MODEL=claude-haiku-5-5
# OCR_DATA_PATH=.data/ocr
