{
  "name": "northstar-people-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.nest.json",
    "dev": "npm run build && node --watch dist-v2/platform/main.js",
    "start": "npm run build && node dist-v2/platform/main.js",
    "jobs:dev": "npm run build && node --watch dist-v2/platform/jobs/worker.js",
    "jobs:start": "node dist-v2/platform/jobs/worker.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.nest.json --noEmit",
    "smoke": "node scripts/smoke-v2.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:cases": "node scripts/seed-cases.mjs",
    "db:seed:payroll": "node scripts/seed-payroll.mjs",
    "db:seed:engagement": "node scripts/seed-engagement.mjs",
    "db:seed:roster": "node scripts/seed-roster.mjs",
    "db:seed:lms": "node scripts/seed-lms.mjs",
    "db:seed:onboarding": "node scripts/seed-onboarding.mjs",
    "dev:idp": "node scripts/dev-oidc-provider.mjs",
    "db:seed:integrations": "node scripts/seed-integrations.mjs",
    "db:seed:access": "node scripts/seed-access.mjs",
    "db:seed:brands": "node scripts/seed-brands.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:migrate:verify": "node scripts/migrate.mjs --verify",
    "db:schema-snapshot": "node scripts/migrate-check.mjs --write-snapshot",
    "ci:migrate-check": "node scripts/migrate-check.mjs",
    "bootstrap:prod": "node scripts/bootstrap-production.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "db:seed:native-auth": "node scripts/seed-native-auth.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "find-my-way": "^9.7.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.5",
    "js-yaml": "^5.5.0",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "fastify": "$fastify",
    "js-yaml": "$js-yaml"
  },
  "engines": {
    "node": ">=22"
  }
}
